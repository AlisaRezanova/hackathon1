# Скопировать в infra/.env.prod и заполнить. Сам .env.prod в git не попадает.
# Используется infra/docker-compose.prod.yml (флаг --env-file infra/.env.prod).

POSTGRES_USER=hackathon
# Обязательно заменить на свой пароль (например: openssl rand -base64 24).
POSTGRES_PASSWORD=
POSTGRES_DB=hackathon

# Адрес, с которого открывается сайт (домен перед reverse-proxy, https).
# Формат — JSON-список в одинарных кавычках; схема (http/https) должна совпадать.
CORS_ORIGINS='["https://your-domain.ru"]'

# Ключ OpenRouter. Пусто — работает встроенная эвристика.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
