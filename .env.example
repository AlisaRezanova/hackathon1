# Copy to .env and adjust if needed. No secrets — hackathon demo only.
# Used by infra/docker-compose.yaml (db + backend) and by backend/app/config.py
# when the backend runs outside Docker.

POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon
POSTGRES_DB=hackathon
POSTGRES_PORT=5432

# Exit-interview LLM engine (backend/app/features/interviews) — OpenRouter.
# Leave the key empty to run on the built-in heuristic fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
